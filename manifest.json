{
  "manifest_version": 3,
  "name": "自定义 HLS 播放器",
  "version": "1.3.0",
  "description": "捕获页面 HLS 视频流并用原生控件播放器直接播放（最简形式），匹配域名可在弹窗中随时修改",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "自定义 HLS 播放器",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  }
}
